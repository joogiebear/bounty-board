{
  "name": "bounty: post, list, balance, gui and errors",
  "instance": "test",
  "bots": ["alice", "bob"],
  "setup": ["op alice"],
  "steps": [
    { "bot": "alice", "command": "/bounty balance" },
    { "bot": "alice", "expectMessage": "Balance: 1,000 coins", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty set bob 100" },
    { "bot": "alice", "expectMessage": "Bounty #1 posted on bob for 100 coins.", "timeout": 3000 },
    { "bot": "bob", "expectMessage": "alice posted a 100 coin bounty on bob!", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty balance" },
    { "bot": "alice", "expectMessage": "Balance: 900 coins", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty list" },
    { "bot": "alice", "expectMessage": "Bounties (page 1/1, 1 total)", "timeout": 3000 },
    { "bot": "alice", "expectMessage": "/#1 bob - 100 coins \\(by alice, (1d|23h 59m) left\\)/", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty mine" },
    { "bot": "alice", "expectMessage": "/#1 bob - 100 coins \\((1d|23h 59m) left\\)/", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty gui" },
    { "bot": "alice", "waitWindow": "Bounty Board - Page 1/1", "timeout": 4000 },
    { "bot": "alice", "click": 0 },
    { "bot": "alice", "closeWindow": true },
    { "bot": "alice", "command": "/bounty set bob 5" },
    { "bot": "alice", "expectMessage": "The minimum bounty is 10 coins.", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty set alice 100" },
    { "bot": "alice", "expectMessage": "You cannot place a bounty on yourself.", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty set nobodyx 100" },
    { "bot": "alice", "expectMessage": "Unknown player: nobodyx", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty set bob 100 4294967297" },
    { "bot": "alice", "expectMessage": "Duration must be between 1 and 72 hours.", "timeout": 3000 },
    { "bot": "bob", "command": "/bounty admin give bob 5" },
    { "bot": "bob", "expectMessage": "You do not have permission.", "timeout": 3000 },
    { "bot": "alice", "command": "/bounty" },
    { "bot": "alice", "expectMessage": "Usage: /bounty <set|list|mine|cancel|balance|gui>", "timeout": 3000 },
    { "expectLog": { "absent": "/Exception|ERROR/" } }
  ]
}
